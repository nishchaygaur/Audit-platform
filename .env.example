# Production Database: Remote Neon PostgreSQL
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase Authentication (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Site URL for email redirection (defaults to https://auditplatform-nu.vercel.app in production)
NEXT_PUBLIC_SITE_URL=https://auditplatform-nu.vercel.app

# Persistent Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
# Optional endpoint for custom S3 / Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your-production-audit-evidence-bucket
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
